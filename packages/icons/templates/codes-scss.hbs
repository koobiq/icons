// Generated by @koobiq/icons from mapping.json and mapping-interop.json, do not edit.
//
// Characters of the "{{{ family }}}" icon font by icon name, for places that take the character
// itself rather than a `.kbq-*` class: `content` or a custom property. The font is loaded by
// the kbq-icons stylesheet.
//
//     @use '@koobiq/icons/fonts/kbq-icons-codes' as icons;
//
//     .my-icon::before {
//         font-family: icons.$font-family;
//         content: icons.code('arrow-down_16');
//     }

@use 'sass:map';
@use 'sass:meta';
@use 'sass:string';

/// `font-family` of the icon font, with its quotes: `"{{{ family }}}"`.
$font-family: string.unquote('"{{{ family }}}"');

/// Codepoint of each icon as hex digits: `'arrow-down_16': 'f733'`.
$codes: (
{{# each codes }}
    '{{{ name }}}': '{{{ hex }}}',
{{/ each }}
);

/// Deprecated icon names (the old names from mapping-interop.json) and the names that replace them.
$deprecated: (
{{# each deprecated }}
    '{{{ oldName }}}': '{{{ name }}}',
{{/ each }}
);

/// The icon's character as a CSS string: `code('arrow-down_16')` gives `"\f733"`.
/// The escape and the quotes survive compressed output and `#{}`, so the result goes straight into
/// `content` or a custom property. An unknown name stops the build, a deprecated one warns.
/// @param {String} $name - icon name with its size, e.g. `'arrow-down_16'`
/// @return {String}
@function code($name) {
    @if meta.type-of($name) != 'string' {
        @error '@koobiq/icons: an icon name is a quoted string, got `#{meta.inspect($name)}`.';
    }

    @if map.has-key($deprecated, $name) {
        $replacement: map.get($deprecated, $name);

        @warn '@koobiq/icons: icon "#{$name}" is deprecated, use "#{$replacement}".';

        $name: $replacement;
    }

    @if not map.has-key($codes, $name) {
        @error '@koobiq/icons: unknown icon "#{$name}".';
    }

    @return string.unquote('"\\#{map.get($codes, $name)}"');
}
